App(
    appid="arf_garage",
    name="ARF Garage",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="arf_garage_app",
    requires=["gui"],
    stack_size=4 * 1024,
    fap_description="Garage door / gate Sub-GHz decoder with the native ARF Sub-GHz UI",
    fap_version="1.0",
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    fap_libs=["assets", "hwdrivers"],
    # [ARF_PORT 2026-10-28] The decoders are NOT compiled into the main binary
    # anymore (that instantiated all ~61 at once -> OOM). They live in a single
    # on-demand-loaded .fal plugin below (am_def). The main app keeps only the
    # catalog + the name-only Protocol Filter list.
    sources=[
        # --- app core (UI copied from applications/main/subghz) ---
        "arf_garage.c",
        "subghz_i.c",
        "subghz_history.c",
        "subghz_last_settings.c",
        "helpers/subghz_txrx.c",
        "helpers/subghz_threshold_rssi.c",
        "helpers/subghz_button_labels.c",
        "helpers/subghz_preset_delta.c",
        # --- dynamic protocol-registry plugin host + loader ---
        "helpers/arf_garage_plugins.c",
        "helpers/arf_garage_protocol_plugin_host.c",
        "views/receiver.c",
        "views/transmitter.c",
        "views/subghz_read_raw.c",
        "scenes/subghz_scene.c",
        "scenes/subghz_scene_start.c",
        "scenes/subghz_scene_receiver.c",
        "scenes/subghz_scene_receiver_config.c",
        "scenes/subghz_scene_receiver_info.c",
        "scenes/subghz_scene_save_name.c",
        "scenes/subghz_scene_save_success.c",
        "scenes/subghz_scene_saved.c",
        "scenes/subghz_scene_saved_menu.c",
        "scenes/subghz_scene_transmitter.c",
        "scenes/subghz_scene_show_error.c",
        "scenes/subghz_scene_show_error_sub.c",
        "scenes/subghz_scene_delete.c",
        "scenes/subghz_scene_delete_success.c",
        "scenes/subghz_scene_radio_settings.c",
        "scenes/subghz_scene_read_raw.c",
        "scenes/subghz_scene_more_raw.c",
        "scenes/subghz_scene_decode_raw.c",
        "scenes/subghz_scene_delete_raw.c",
        "scenes/subghz_scene_need_saving.c",
        "scenes/subghz_scene_protocol_list.c",
        # --- catalog only (route resolution + Protocol Filter names) ---
        "protocols/protocol_items.c",
        # [ARF_PORT] raw + custom_btn are used directly by the main UI (RAW
        # record/read and the transmitter's custom-button D-pad), so they stay in
        # the main binary. The am_def.fal plugin carries its own copies for the
        # decoders. Everything else lives only in the plugin.
        "protocols/raw.c",
        "protocols/custom_btn.c",
    ],
)

# -----------------------------------------------------------------------------
# [ARF_PORT 2026-10-28] Single on-demand protocol-registry plugin (.fal). It
# carries only the ~21 most-common garage/gate decoders; the host loads it at RX
# time so the receiver instantiates just that subset (instead of all ~61 -> OOM).
# fal_embedded=True ships the .fal inside the .fap (extracted to
# apps_assets/arf_garage/plugins/).
# -----------------------------------------------------------------------------

# NOTE: appid must be globally unique across ALL apps in the tree. ARF-Cars
# already declares an "am_def" plugin, so this one is named "arf_garage_am_def"
# to avoid a duplicate-app-declaration collision (which would silently drop this
# plugin from the build). The host requests this exact name (see
# arf_garage_get_registry_plugin_name()); fal_embedded installs it as
# apps_assets/arf_garage/plugins/arf_garage_am_def.fal.
App(
    appid="arf_garage_am_def",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="arf_garage_am_plugin_ep",
    requires=["arf_garage"],
    sources=[
        "protocols/plugins/arf_garage_am_plugin.c",
        "protocols/raw.c",
        "protocols/bin_raw.c",
        "protocols/custom_btn.c",
        "protocols/keeloq_common.c",
        # --- the 21 garage/gate decoders ---
        "protocols/gate_tx.c",
        "protocols/keeloq.c",
        "protocols/nice_flo.c",
        "protocols/nice_flor_s.c",
        "protocols/came.c",
        "protocols/came_twee.c",
        "protocols/came_atomo.c",
        "protocols/faac_slh.c",
        "protocols/hormann.c",
        "protocols/somfy_telis.c",
        "protocols/somfy_keytis.c",
        "protocols/princeton.c",
        "protocols/linear.c",
        "protocols/secplus_v1.c",
        "protocols/secplus_v2.c",
        "protocols/megacode.c",
        "protocols/holtek.c",
        "protocols/holtek_ht12x.c",
        "protocols/smc5326.c",
        "protocols/alutech_at_4n.c",
        "protocols/jarolift.c",
    ],
    fal_embedded=True,
)
