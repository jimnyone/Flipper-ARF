    ],
    fal_embedded=True,
)

App(
    appid="fm_honda1",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="arf_cars_fm_honda1_plugin_ep",
    requires=["arf_cars"],
    sources=[
        "protocols/plugins/arf_cars_fm_honda1_plugin.c",
        "protocols/raw.c",
