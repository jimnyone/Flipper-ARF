App(
    appid="arf_cars",
    name="ARF Cars",
    apptype=FlipperAppType.EXTERNAL,
    targets=["f7"],
    entry_point="arf_cars_app",
    requires=["gui"],
    stack_size=4 * 1024,
    fap_description="Automotive Sub-GHz decoder with the native ARF Sub-GHz UI",
    fap_version="1.1",
    fap_icon="icon.png",
    fap_category="Sub-GHz",
    fap_libs=["assets", "hwdrivers"],
    # [ARF_PORT 2026-10-26] The decoders are NOT compiled into the main binary
    # anymore (that instantiated all ~41 at once -> OOM). They live in per-route
    # .fal plugins below, loaded one at a time. The main app keeps only the
    # catalog + the name-only Protocol Filter list.
    sources=[
        # --- app core (UI copied from applications/main/subghz) ---
        "arf_cars.c",
        "subghz_i.c",
        "subghz_history.c",
        "subghz_last_settings.c",
        "helpers/subghz_txrx.c",
        "helpers/subghz_threshold_rssi.c",
        "helpers/subghz_button_labels.c",
        "helpers/subghz_preset_delta.c",
        # --- dynamic protocol-registry plugin host + loader ---
        "helpers/arf_cars_plugins.c",
        "helpers/arf_cars_protocol_plugin_host.c",
        "views/receiver.c",
        "views/transmitter.c",
        "views/subghz_read_raw.c",
        "scenes/subghz_scene.c",
        "scenes/subghz_scene_start.c",
        "scenes/subghz_scene_receiver.c",
        "scenes/subghz_scene_receiver_config.c",
        "scenes/subghz_scene_receiver_info.c",
        "scenes/subghz_scene_save_name.c",
        "scenes/subghz_scene_save_success.c",
        "scenes/subghz_scene_saved.c",
        "scenes/subghz_scene_saved_menu.c",
        "scenes/subghz_scene_transmitter.c",
        "scenes/subghz_scene_show_error.c",
        "scenes/subghz_scene_show_error_sub.c",
        "scenes/subghz_scene_delete.c",
        "scenes/subghz_scene_delete_success.c",
        "scenes/subghz_scene_radio_settings.c",
        "scenes/subghz_scene_read_raw.c",
        "scenes/subghz_scene_more_raw.c",
        "scenes/subghz_scene_decode_raw.c",
        "scenes/subghz_scene_delete_raw.c",
        "scenes/subghz_scene_need_saving.c",
        "scenes/subghz_scene_protocol_list.c",
        # --- catalog only (route resolution + Protocol Filter names) ---
        "protocols/protocol_items.c",
        # [ARF_PORT] raw + custom_btn are used directly by the main UI (RAW
        # record/read and the transmitter's custom-button D-pad), so they stay in
        # the main binary. The per-route .fal plugins carry their own copies for
        # the decoders. Everything else lives only in the plugins.
        "protocols/raw.c",
        "protocols/custom_btn.c",
    ],
)

# -----------------------------------------------------------------------------
# [ARF_PORT 2026-10-26] Per-route protocol-registry plugins (.fal). Each carries
# only the decoders for its route; the host loads one at a time so the receiver
# instantiates just that subset (instead of all ~41 -> OOM). fal_embedded=True
# ships the .fal inside the .fap (extracted to apps_assets/arf_cars/plugins/).
# -----------------------------------------------------------------------------

App(
    appid="am_def",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="arf_cars_am_plugin_ep",
    requires=["arf_cars"],
    sources=[
        "protocols/plugins/arf_cars_am_plugin.c",
        "protocols/raw.c",
        "protocols/bin_raw.c",
        "protocols/custom_btn.c",
        "protocols/common.c",
        "protocols/keeloq_common.c",
        "protocols/keeloq.c",
        "protocols/hitag2_seed.c",
        "protocols/hitag2_key_db.c",
        "protocols/chrysler.c",
        "protocols/fiat_v0.c",
        "protocols/fiat_v1.c",
        "protocols/fiat_v2.c",
        "protocols/ford_v0.c",
        "protocols/ford_v3.c",
        "protocols/honda_v1.c",
        "protocols/kia_v1.c",
        "protocols/kia_v2.c",
        "protocols/mazda_v0.c",
        "protocols/psa.c",
        "protocols/renault_v0.c",
        "protocols/renault_v1.c",
        "protocols/subaru.c",
        "protocols/star_line.c",
        "protocols/gm_v0.c",
        "protocols/gm_v1.c",
        "protocols/toyota_v0.c",
        "protocols/toyota_v1.c",
        "protocols/opel_v1.c",
        "protocols/bmw.c",
        "protocols/sheriff_cfm.c",
        "protocols/suzuki.c",
        "protocols/mazda_v1.c",
        "protocols/mazda_v2.c",
    ],
    fal_embedded=True,
)

App(
    appid="am_vag",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="arf_cars_am_vag_plugin_ep",
    requires=["arf_cars"],
    sources=[
        "protocols/plugins/arf_cars_am_vag_plugin.c",
        "protocols/raw.c",
        "protocols/bin_raw.c",
        "protocols/custom_btn.c",
        "protocols/aut64.c",
        "protocols/vag.c",
    ],
    fal_embedded=True,
)

App(
    appid="fm_def",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="arf_cars_fm_plugin_ep",
    requires=["arf_cars"],
    sources=[
        "protocols/plugins/arf_cars_fm_plugin.c",
        "protocols/raw.c",
        "protocols/bin_raw.c",
        "protocols/custom_btn.c",
        "protocols/common.c",
        "protocols/keeloq_common.c",
        "protocols/keeloq.c",
        "protocols/hitag2_seed.c",
        "protocols/hitag2_key_db.c",
        "protocols/scher_khan.c",
        "protocols/kia_v0.c",
        "protocols/kia_v3_v4.c",
        "protocols/kia_v5.c",
        "protocols/kia_v6.c",
        "protocols/kia_v7.c",
        "protocols/mazda_v0.c",
        "protocols/psa.c",
        # renault_v1 reuses Fiat V1's Hitag2 crypto, so fiat_v1.c is required here
        # even though "Fiat V1" itself is an AM protocol.
        "protocols/fiat_v1.c",
        "protocols/renault_v1.c",
        "protocols/mercedes_v0.c",
        "protocols/mercedes_v1.c",
        "protocols/mitsubishi_v0.c",
    ],
    fal_embedded=True,
)

App(
    appid="fm_f4",
    apptype=FlipperAppType.PLUGIN,
    targets=["f7"],
    entry_point="arf_cars_fm_f4_plugin_ep",
    requires=["arf_cars"],
